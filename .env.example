NODE_ENV=development
BACKEND_PORT=5001
PAYMENT_GATEWAY_PORT=5002
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

DATABASE_URL=postgresql://payledger:payledger@localhost:5432/payledger

DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=2
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000

REDIS_URL=redis://localhost:6379

# Generate real random values for these two — e.g. `openssl rand -hex 32` —
# never reuse the example value.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_at_least_32_characters
JWT_ISSUER=payledger
JWT_AUDIENCE=payledger-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Leave unset for local dev (host-only cookies already work across
# localhost ports). In production, where the frontend and API are on
# different subdomains of the same parent domain, set this to the shared
# parent so both can see the auth cookies, e.g.:
# COOKIE_DOMAIN=.devamit.info

AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=15
AUTH_SESSION_TTL_DAYS=30

RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_REFRESH_MAX=20
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60

PAYMENT_MIN_DEPOSIT_INR=100
PAYMENT_MAX_DEPOSIT_INR=25000
PAYMENT_EXPIRY_MINUTES=15
PAYMENT_GATEWAY_BASE_URL=http://localhost:5002
# Must be the SAME value the payment-gateway process uses — it's the HMAC
# key both sides use to sign/verify webhooks. Generate a real random value.
PAYMENT_WEBHOOK_SECRET=replace_with_a_long_random_secret_at_least_32_characters
PAYLEDGER_WEBHOOK_URL=http://localhost:5001/api/v1/payments/webhook

TRANSFER_MAX_AMOUNT_INR=25000
TRANSFER_DAILY_LIMIT_INR=50000
TRANSFER_FEE_PERCENT=1
TRANSFER_FEE_MIN_INR=1
TRANSFER_FEE_MAX_INR=20

WITHDRAWAL_MIN_AMOUNT_INR=100
WITHDRAWAL_MAX_AMOUNT_INR=25000
